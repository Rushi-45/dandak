{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saputara-narmada:schemas:stay:v1",
  "title": "Stay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "slug", "name", "type", "district", "cluster", "spot_id", "coordinates", "price_band", "booking", "contact", "amenities", "nearest_spots", "notes", "provenance"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/kebab" },
    "slug": { "$ref": "#/$defs/kebab" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "type": { "enum": ["hotel", "resort", "tent-city", "eco-campsite", "homestay", "dharamshala", "guesthouse"] },
    "district": { "enum": ["dang", "narmada"] },
    "cluster": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/kebab" }] },
    "spot_id": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^(dang|narmada)-[a-z0-9]+(-[a-z0-9]+)*$" }] },
    "coordinates": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["lat", "lng", "precision"],
          "properties": {
            "lat": { "type": "number", "minimum": 8, "maximum": 37 },
            "lng": { "type": "number", "minimum": 68, "maximum": 98 },
            "precision": { "enum": ["exact", "approximate", "area"] }
          }
        }
      ]
    },
    "price_band": { "enum": ["budget", "mid", "premium", "luxury"] },
    "booking": {
      "type": "object", "additionalProperties": false, "required": ["mode", "url", "notes"],
      "properties": {
        "mode": { "enum": ["official-portal", "ota", "phone", "walk-in"] },
        "url": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 300 }] },
        "notes": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 400 }] }
      }
    },
    "contact": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 200 }] },
    "amenities": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 80 } },
    "nearest_spots": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "distance_km"],
        "properties": {
          "id": { "type": "string", "pattern": "^(dang|narmada)-[a-z0-9]+(-[a-z0-9]+)*$" },
          "distance_km": { "type": "number", "minimum": 0, "maximum": 200 }
        }
      }
    },
    "notes": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 600 }] },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["created", "last_verified", "confidence", "sources", "needs_verification"],
      "properties": {
        "created": { "$ref": "#/$defs/isoDate" },
        "last_verified": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/isoDate" }] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "sources": {
          "type": "array", "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["title"],
            "properties": {
              "title": { "type": "string", "maxLength": 200 },
              "url": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 300 }] },
              "publisher": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 200 }] },
              "accessed": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/isoDate" }] }
            }
          }
        },
        "needs_verification": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_.]*$", "maxLength": 80 } }
      }
    }
  },
  "$defs": {
    "kebab": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "isoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
