{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saputara-narmada:schemas:itinerary:v1",
  "title": "Itinerary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "slug", "title", "duration_days", "districts", "themes", "best_months", "base_hub", "party", "stops", "day_notes", "total_drive_km", "notes", "provenance"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/kebab" },
    "slug": { "$ref": "#/$defs/kebab" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "duration_days": { "type": "integer", "minimum": 1, "maximum": 5 },
    "districts": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["dang", "narmada"] } },
    "themes": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/kebab" } },
    "best_months": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
    "base_hub": { "$ref": "#/$defs/kebab" },
    "party": { "enum": ["family", "couple", "friends", "solo", "any"] },
    "stops": {
      "type": "array", "minItems": 2, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["day", "order", "spot_id", "duration_min"],
        "properties": {
          "day": { "type": "integer", "minimum": 1, "maximum": 5 },
          "order": { "type": "integer", "minimum": 1, "maximum": 20 },
          "spot_id": { "type": "string", "pattern": "^(dang|narmada)-[a-z0-9]+(-[a-z0-9]+)*$" },
          "duration_min": { "type": "integer", "minimum": 15, "maximum": 480 },
          "note": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "day_notes": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["day", "note"],
        "properties": {
          "day": { "type": "integer", "minimum": 1, "maximum": 5 },
          "note": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "total_drive_km": { "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 1000 }] },
    "notes": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 600 }] },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["created", "last_reviewed"],
      "properties": {
        "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "last_reviewed": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }] }
      }
    }
  },
  "$defs": {
    "kebab": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 }
  }
}
